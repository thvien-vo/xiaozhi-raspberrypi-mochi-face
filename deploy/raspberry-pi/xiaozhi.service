# Fullscreen robot face. Installed by install-autostart.sh, which fills in @APP_DIR@.
# Started from the desktop session (xiaozhi-autostart.desktop) once the display exists,
# so there is deliberately no [Install] section.
[Unit]
Description=Xiaozhi robot face
After=pipewire.service wireplumber.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/python main.py --mode gui
# Restart after a crash, but stay closed after a deliberate exit (Esc)
Restart=on-failure
RestartSec=3
